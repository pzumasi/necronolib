{{!-- Necronolib — Reader (geschlossenes Buch → Doppelseiten) --}}
<div class="nl-reader">
  {{#*inline "nlPage"}}
  <div class="nl-page nl-page-{{side}} {{#if page.keeperOnly}}nl-keeper-only{{/if}}" data-folio="{{page.folio}}" data-page-id="{{page.id}}">
    {{#if isGM}}
    <button type="button" class="nl-keeper-toggle {{#if page.keeperOnly}}active{{/if}}" data-action="toggleKeeperOnly" data-page-id="{{page.id}}"
            title="{{#if page.keeperOnly}}{{localize 'NECRONOLIB.Reader.KeeperOnlyOn'}}{{else}}{{localize 'NECRONOLIB.Reader.KeeperOnlyOff'}}{{/if}}">
      <i class="fa-solid {{#if page.keeperOnly}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
    </button>
    {{/if}}
    {{#if page.showTitle}}<div class="nl-page-heading nl-page-heading-{{page.titleTag}}">{{page.name}}</div>{{/if}}
    {{{page.html}}}
  </div>
  {{/inline}}
  <header class="nl-reader-bar">
    <span class="nl-reader-title">{{journal.name}}</span>
    <span class="nl-reader-pages">{{label}}</span>
    <span class="nl-spacer"></span>
    {{#if following}}<span class="nl-following" title="{{localize 'NECRONOLIB.Reader.Following'}}"><i class="fa-solid fa-eye"></i></span>{{/if}}
    {{#if isGM}}
    <button type="button" class="nl-gm-btn nl-show-btn {{#if showing}}active{{/if}}" data-action="toggleShow"
            title="{{localize 'NECRONOLIB.Reader.ShowTitle'}}">
      <i class="fa-solid {{#if showing}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
      {{#if showing}}{{localize "NECRONOLIB.Reader.Unshow"}}{{else}}{{localize "NECRONOLIB.Reader.Show"}}{{/if}}
    </button>
    <button type="button" class="nl-gm-btn nl-share-btn {{#if sharedCount}}active{{/if}}" data-action="shareDialog"
            title="{{localize 'NECRONOLIB.Reader.ShareTitle'}}">
      <i class="fa-solid fa-share-nodes"></i>
      {{#if sharedCount}}{{sharedLabel}}{{else}}{{localize "NECRONOLIB.Reader.Share"}}{{/if}}
    </button>
    {{/if}}
  </header>

  <div class="nl-stage">
    {{#if isClosed}}
    {{!-- Geschlossenes Buch + Aufschlagen --}}
    <div class="nl-closed">
      {{#if hasPages}}
      <div class="nl-book-open-target" role="button" tabindex="0" data-action="turnNext"
           title="{{localize 'NECRONOLIB.Reader.OpenButton'}}" aria-label="{{localize 'NECRONOLIB.Reader.OpenButton'}}">
        {{> "modules/necronolib/templates/partials/book.hbs" cover=cover.cover vars=cover.vars runes=cover.runes runesTitle=cover.runesTitle}}
      </div>
      <button type="button" class="nl-open-btn" data-action="turnNext">
        <i class="fa-solid fa-book-open"></i> {{localize "NECRONOLIB.Reader.OpenButton"}}
      </button>
      <p class="nl-open-hint">{{localize "NECRONOLIB.Reader.OpenHint"}}</p>
      {{else}}
      {{> "modules/necronolib/templates/partials/book.hbs" cover=cover.cover vars=cover.vars runes=cover.runes runesTitle=cover.runesTitle}}
      <p class="nl-empty">{{localize "NECRONOLIB.Reader.Empty"}}</p>
      {{/if}}
    </div>
    {{else if current}}
    {{!-- Doppelseite (Spread 0: nur rechte Seite = Titelseite) --}}
    <div class="nl-spread">
      {{#if current.left}}
      {{> nlPage page=current.left side="left" isGM=isGM}}
      {{/if}}
      {{#if current.right}}
      {{> nlPage page=current.right side="right" isGM=isGM}}
      {{/if}}
    </div>
    {{else}}
    <div class="nl-empty">{{localize "NECRONOLIB.Reader.Empty"}}</div>
    {{/if}}
  </div>

  <footer class="nl-reader-nav">
    <button type="button" data-action="turnPrev" {{#if isFirst}}disabled{{/if}}>
      <i class="fa-solid fa-angle-left"></i> {{localize "NECRONOLIB.Reader.Prev"}}
    </button>
    <button type="button" data-action="turnNext" {{#if isLast}}disabled{{/if}}>
      {{localize "NECRONOLIB.Reader.Next"}} <i class="fa-solid fa-angle-right"></i>
    </button>
  </footer>

  {{#if coc7}}
  <aside class="nl-coc7">
    <div class="nl-coc7-name"><i class="fa-solid fa-eye"></i> {{coc7.name}}</div>
    <div class="nl-coc7-chips">
      {{#if coc7.isMythos}}<span class="nl-chip nl-chip-mythos">{{localize "NECRONOLIB.Coc7.Mythos"}}</span>{{/if}}
      {{#if coc7.isOccult}}<span class="nl-chip nl-chip-occult">{{localize "NECRONOLIB.Coc7.Occult"}}</span>{{/if}}
      <span class="nl-chip">{{localize "NECRONOLIB.Coc7.SanLoss"}}: {{coc7.sanityLoss}}</span>
      <span class="nl-chip">{{localize "NECRONOLIB.Coc7.MythosRating"}}: {{coc7.mythosRating}}</span>
      {{#if coc7.cmi}}<span class="nl-chip">CMI +{{coc7.cmi}}</span>{{/if}}
      {{#if coc7.cmf}}<span class="nl-chip">CMF +{{coc7.cmf}}</span>{{/if}}
      {{#if coc7.studyWeeks}}<span class="nl-chip">{{localize "NECRONOLIB.Coc7.Study"}}: {{coc7.studyWeeks}}</span>{{/if}}
    </div>
    {{#if coc7CanAct}}
    <div class="nl-coc7-actions">
      <button type="button" class="nl-coc7-act" data-action="coc7InitialReading"
              title="{{localize 'NECRONOLIB.Coc7.InitialReadingTitle'}}">
        <i class="fa-solid fa-book-open-reader"></i> {{localize "NECRONOLIB.Coc7.InitialReading"}}
      </button>
      <button type="button" class="nl-coc7-act" data-action="coc7Reference"
              title="{{localize 'NECRONOLIB.Coc7.ReferenceTitle'}}">
        <i class="fa-solid fa-scroll"></i> {{localize "NECRONOLIB.Coc7.Reference"}}
      </button>
    </div>
    {{/if}}
    {{#if keeperHtml}}
    <div class="nl-coc7-keeper">
      <div class="nl-coc7-keeper-label">{{localize "NECRONOLIB.Coc7.KeeperNotes"}}</div>
      {{{keeperHtml}}}
    </div>
    {{/if}}
  </aside>
  {{/if}}
</div>
