{{!-- Necronolib — Cover-Partial (geschlossen Buch, Frontansicht). Nutzt coverVars-Werte aus dem Kontext (vars).
      Titel und Runen werden immer gerendert (hidden-Toggle), damit applyCover live umschalten kann. --}}
<div class="nl-book"
     data-nl-book
     data-material="{{cover.material}}"
     data-wear="{{cover.wear}}"
     data-clasp="{{cover.clasps}}"
     data-thickness="{{cover.thickness}}"
     style="{{vars}}">
  <div class="nl-pages-edge"></div>
  <div class="nl-spine-hinge"></div>
  <div class="nl-wear"></div>
  <div class="nl-sheen"></div>
  <div class="nl-title-wrap nl-pos-{{cover.title.position}}" data-nl-title-wrap>
    <span class="nl-title nl-font-{{cover.title.font}} nl-effect-{{cover.title.effect}}" data-nl-title {{#unless cover.title.text}}hidden{{/unless}}>{{cover.title.text}}</span>
    <span class="nl-runes" data-nl-runes title="{{runesTitle}}" {{#if cover.title.text}}hidden{{/if}}>{{runes}}</span>
  </div>
  <div class="nl-clasp nl-clasp-top"></div>
  <div class="nl-clasp nl-clasp-bottom"></div>
</div>
